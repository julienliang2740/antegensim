# Copy to .env (gitignored) and fill in only the providers you use.
# empyrean.config loads this file once at import time (python-dotenv); values are
# used only by model.py adapters and are never sent to the frontend or written to
# logs or world records.  Leave unused lines empty: empty values are ignored and
# GET /api/models reports which configured models are missing credentials.

# Anthropic API (provider "anthropic")
ANTHROPIC_API_KEY=

# OpenAI API (provider "openai")
OPENAI_API_KEY=

# Fireworks (provider "fireworks", OpenAI-compatible endpoint)
FIREWORKS_API_KEY=

# AWS Bedrock (provider "bedrock", boto3 converse).  Optional: the example registry
# entry uses the boto3 default credential chain (profiles, roles, session tokens).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Microsoft AI Foundry / Azure OpenAI (provider "foundry")
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI OpenAI-compatible v1 endpoint (provider "openai"; entries azure-gpt6-luna and
# azure-deepseek-v4-flash): https://<resource>.openai.azure.com/openai/v1 and the resource key
AZURE_AI_V1_ENDPOINT=
AZURE_AI_API_KEY=

# Claude Code CLI (provider "claude_cli") needs no variable here: it uses the CLI's own
# login and receives NONE of the values above (minimal environment allowlist).

# Optional: path to a model registry JSON (defaults to backend/empyrean/models.example.json)
EMPYREAN_MODELS_FILE=

# Optional: where run data is written (defaults to ./worlds)
EMPYREAN_WORLDS_DIR=

# Optional: the model new runs start from (defaults to claude-cli-haiku; falls back to fake-heuristic when unavailable)
EMPYREAN_DEFAULT_MODEL=

# Optional: backend bind address (defaults 127.0.0.1:8000)
EMPYREAN_API_HOST=
EMPYREAN_API_PORT=

# Optional: log level for the backend process (INFO)
EMPYREAN_LOG_LEVEL=

# Optional: fsync turn files (1, default) or not (0: ~2.5x faster commits, safe against a process
# crash but not a power loss), and how many threads fsync in parallel (8)
EMPYREAN_FSYNC=
EMPYREAN_FSYNC_WORKERS=

# Optional: model calls that run at once across all open runs (default 16). Each round's decisions are
# made together at round start; each claude_cli call is a ~250 MB subprocess, so lower it on a small machine.
EMPYREAN_MODEL_CONCURRENCY=

# Optional: label written into every manifest and turn record (dev)
EMPYREAN_CODE_REVISION=

# ---------------------------------------------------------------------------------------------
# Assistant (docs/ASSISTANT.md).  None of these is a secret.  Model keys come from the registry;
# the defaults use the Claude Code CLI (no variable needed here).
# ---------------------------------------------------------------------------------------------

# Model key per assistant profile (defaults: claude-cli-sonnet-assistant for chat and author,
# claude-cli-haiku-assistant for narrator and summarizer; fake-assistant for a free demo)
EMPYREAN_ASSISTANT_MODEL_CHAT=
EMPYREAN_ASSISTANT_MODEL_NARRATOR=
EMPYREAN_ASSISTANT_MODEL_AUTHOR=
EMPYREAN_ASSISTANT_MODEL_SUMMARIZER=

# Spend limits in USD (list-price estimates; separate from the agents' real_usage):
# chat per scope 5.0, storybook per run 2.0, per story job 5.0, per message 0.75, global 20.0
EMPYREAN_ASSISTANT_CHAT_BUDGET_USD=
EMPYREAN_ASSISTANT_STORYBOOK_BUDGET_USD=
EMPYREAN_ASSISTANT_STORY_BUDGET_USD=
EMPYREAN_ASSISTANT_MESSAGE_BUDGET_USD=
EMPYREAN_ASSISTANT_GLOBAL_BUDGET_USD=

# Automatic storybook narration of new runs: on | off | auto (default off: narration only on request;
# auto = on unless a paid narrator would narrate a run whose agents are all fake)
EMPYREAN_STORYBOOK_AUTO=

# Dictate (local speech input): Whisper model (default large-v3-turbo; medium or small are faster,
# "off" disables Dictate) and whether the backend preloads it at start (1, default)
EMPYREAN_WHISPER_MODEL=
EMPYREAN_WHISPER_PRELOAD=

# ---------------------------------------------------------------------------------------------
# Not read from this file, listed for completeness:
# EMPYREAN_API_PROXY is read by the Vite dev server from its own environment
#   (cd frontend && EMPYREAN_API_PROXY=http://127.0.0.1:8011 npm run dev).
# EMPYREAN_ALLOW_LIVE=1 lets scripts/run_sim.py use a paid model; set it on the command line for
#   one deliberate run, never here.  EMPYREAN_LIVE_TESTS / EMPYREAN_LIVE_MODELS likewise enable
#   the paid live tests (README "Tests").
